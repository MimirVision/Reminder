/sw.js
  Cache-Control: no-cache
/post/sw.js
  Cache-Control: no-cache
/ledger/sw.js
  Cache-Control: no-cache
/ledger/assets/*
  Cache-Control: public, max-age=31536000, immutable
/ledger/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; manifest-src 'self'; worker-src 'self'
/vakt/sw.js
  Cache-Control: no-cache
/vakt/assets/*
  Cache-Control: public, max-age=31536000, immutable
/vakt/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; manifest-src 'self'; worker-src 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Over-the-air updates for the phone app (scripts/publish-ota.mjs). The manifest is always fetched fresh; bundles and assets are named by their content.
/ota/*/manifest.json
  Cache-Control: no-cache
  expo-protocol-version: 1
  expo-sfv-version: 0
/ota/*/bundles/*
  Cache-Control: public, max-age=31536000, immutable
/ota/*/assets/*
  Cache-Control: public, max-age=31536000, immutable
