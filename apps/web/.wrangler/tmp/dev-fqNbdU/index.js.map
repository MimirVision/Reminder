{
  "gutters_autumn": { "title": "Rens takrenner og nedløpsrør", "notes": "Før første frost. Fjern løv; sjekk skjøter og beslag." },
  "gutters_spring": { "title": "Sjekk takrenner etter vinteren", "notes": "Is og snø kan bøye beslag og løsne skjøter." },
  "drain_taps": { "title": "Tøm og steng utekraner", "notes": "Steng ventilen innendørs og åpne utekranen slik at den tømmes. Gjør det før første hardfrost." },
  "yard_drains": { "title": "Rens sluk og rister rundt huset", "notes": "Løv og slam i sluk gir vann mot grunnmuren." },
  "snow_prep": { "title": "Gjør snøutstyret klart; sjekk snøfangere", "notes": "Spader, salt/strøgrus, snøfangere. Vit hvor du kommer opp på taket." },
  "roof_moss": { "title": "Se over taket og fjern mose", "notes": "Se fra bakken eller med kikkert først. Gå bare opp når det er trygt, eller hyr inn noen." },
  "windows_seals": { "title": "Sjekk tetting rundt vinduer og dører; smør hengsler", "notes": "Trekk, sprukne fuger, låser som sitter fast." },
  "smoke_detectors": { "title": "Test røykvarslere", "notes": "Trykk på testknappen; bytt batteri når de piper eller hvert år. Sjekk lokale anbefalinger." },
  "fire_extinguisher": { "title": "Sjekk brannslukker og brannteppe", "notes": "Måleren i grønt, innenfor dato, lett tilgjengelig." },
  "earth_fault_test": { "title": "Test jordfeilbryteren", "notes": "Trykk på testknappen i sikringsskapet; den skal slå ut. Slå den på igjen etterpå." },
  "wet_rooms": { "title": "Sjekk silikon og fuger på bad og vaskerom", "notes": "Sprekker slipper vann inn i konstruksjonen. Gjør om fugene når de er ødelagt eller muggne." },
  "water_heater": { "title": "Sjekk varmtvannsberederen og sikkerhetsventilen", "notes": "Se etter lekkasjer eller korrosjon; betjen sikkerhetsventilen etter bruksanvisningen." },
  "chimney": { "title": "Feiing og tilsyn med ildsted", "notes": "Kommunen setter opp dette; sjekk intervallet ditt og at feieren får tilgang." },
  "heat_pump_filters": { "title": "Rengjør filtrene i varmepumpen", "notes": "Skyll filtrene i innedelen; fjern løv og snø rundt utedelen." },
  "ventilation_filters": { "title": "Bytt ventilasjonsfilter", "notes": "Balansert ventilasjon med varmegjenvinning: sjekk filtertype i bruksanvisningen." },
  "basement_damp": { "title": "Sjekk kjelleren for fukt, mugg og luftfuktighet", "notes": "Se i hjørner, sluk og ved lagrede kasser. Noter luftfuktigheten." },
  "facade": { "title": "Se over trefasaden og mal eller beis", "notes": "Se etter avflaking, sprekker og råte nær bakken. Hvor ofte man må beise varierer mye." },
  "septic": { "title": "Tøm slamavskilleren", "notes": "Intervallet bestemmes av kommunen og typen tank. Bekreft ditt." },
  "well_water": { "title": "Test drikkevannet fra brønnen", "notes": "Minst bakterier og nitrat; mer hvis smak eller farge endrer seg." },
  "mower_service": { "title": "Service på gressklipperen og hageredskapene", "notes": "Kniver, olje, tennplugg eller batteri, før sesongen." },
  "garden_spring": { "title": "Vårrydding i hagen og plenstell", "notes": "Riv, luft plenen, så i bare flekker, første klipp." },
  "fence_gates": { "title": "Sjekk gjerde, porter og hagekonstruksjoner", "notes": "Stolper, hengsler, råte; behandle eller reparer." },
  "garden_autumn": { "title": "Høstpuss i hagen: riv løv, beskjær, vinterklargjør", "notes": "Ta inn slanger, dekk til ømfintlige planter, sett løker." }
}
