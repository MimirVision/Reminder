{
  // Ledger's own Cloudflare Worker (static assets only), separate from the "reminder" worker that serves Home Memory and Post.
  // Build first with VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY set (see .env.example), then: npx wrangler deploy
  "name": "ledger",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
