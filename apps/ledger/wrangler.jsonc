{
  // Ledger's own Cloudflare Worker (static assets only), separate from the "reminder" worker that serves Home Memory and Post.
  // Cloudflare (Workers & Pages > Create > Import a repository): root directory apps/ledger, build command `npm run build`,
  // deploy command `npx wrangler deploy`. The Supabase settings come from .env.production.
  "name": "ledger",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
