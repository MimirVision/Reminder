# Copy to .env.local. Use the same Supabase project as Home Memory and Post (the values in apps/web/.env.local):
# Supabase > Project Settings > API > Project URL and the publishable/anon key. Never put the service_role key here.
# Leave both empty to run Ledger in demo mode with fictional data stored only in your browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
